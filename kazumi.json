  "muliSources": false,
  "useWebview": true,
  "useNativePlayer": true,
  "usePost": false,
  "useLegacyParser": false,
  "adBlocker": true,
  "userAgent": "",
  "baseURL": "https://www.cycani.org/",
  "searchURL": "",
  "searchList": "",
  "searchName": "",
  "searchResult": "",
  "chapterRoads": "",
  "chapterResult": "",
  "referer": "https://www.cycani.org/",
  "searchMode": "api",
  "chapterMode": "api",
  "searchApiConfig": {
    "request": {
      "method": "GET",
      "url": "https://www.cycani.org/api/videos/search",
      "headers": {
        "Accept": "application/json",
        "X-App-Name": "cyc_web",
        "X-App-Version": "cycweb",
